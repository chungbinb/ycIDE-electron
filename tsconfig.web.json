{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "jsx": "react-jsx",
    "outDir": "./out/renderer",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "plugins/*/plugin.json"]
}
